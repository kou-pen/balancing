{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clangd: prepare compile commands",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "clangd: include STM32 Core",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/prepare_clangd.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "clangd: prepare compile commands",
      "problemMatcher": []
    },
    {
      "label": "Ruff: check",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/dev_lint.py",
        "ruff-check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Ruff: format check",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/dev_lint.py",
        "ruff-format-check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Host: C/C++ tests",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/run_host_tests.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Docs: validate",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/validate_specs.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "CubeIDE: metadata check",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/sync_cubeide_cpp.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
