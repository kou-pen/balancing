# Normalize text across Windows (CubeIDE/KiCad) and Linux.
* text=auto

*.c         text eol=lf
*.h         text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.s         text eol=lf
*.ld        text eol=lf
*.ioc       text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf
.project    text eol=lf
.cproject   text eol=lf
.mxproject  text eol=lf
.editorconfig text eol=lf
.clang-format text eol=lf
*.kicad_pro text eol=lf
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf
*.kicad_dru text eol=lf

# Explicit binary assets; large CAD files can migrate to Git LFS later.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.STEP      binary
*.step      binary
*.stp       binary
*.stl       binary
*.3mf       binary
*.glb       binary
*.gltf      binary
*.pptx      binary
*.docx      binary
*.xlsx      binary
# Preserved vendor/generated inputs: do not rewrite their whitespace.
firmware/f446/balancing_f446/Drivers/** -whitespace
firmware/f446/balancing_f446/Core/** -whitespace
docs/assets/mermaid.min.js -whitespace
# Markdown uses two trailing spaces as intentional hard line breaks.
*.md whitespace=-trailing-space
docs/assets/stylesheet-example.css -whitespace
firmware/f446/balancing_f446/.mxproject -whitespace
